# 复制为 .env 后填写，三项必须齐全，缺一项都会退回规则兜底模式。
# 真实环境变量优先于本文件；改完需要重启服务。

# 任意 OpenAI 兼容端点（末尾不要多加 /chat/completions）
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# 常见示例
# DeepSeek    LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
# 通义千问兼容 LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# 本地 Ollama  LLM_BASE_URL=http://127.0.0.1:11434/v1         LLM_MODEL=qwen2.5:7b   LLM_API_KEY=ollama
